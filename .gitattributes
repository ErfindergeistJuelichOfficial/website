# Normalise all text files to LF in the repo and on checkout
* text=auto eol=lf

# Explicit text types (project standard: LF, 2-space indent)
*.php   text eol=lf
*.js    text eol=lf
*.css   text eol=lf
*.html  text eol=lf
*.json  text eol=lf
*.md    text eol=lf
*.py    text eol=lf
*.txt   text eol=lf
*.yml   text eol=lf
*.yaml  text eol=lf
*.svg   text eol=lf
*.xml   text eol=lf
Dockerfile text eol=lf

# Binary types — never apply line-ending conversion
*.webp  binary
*.png   binary
*.jpg   binary
*.jpeg  binary
*.gif   binary
*.ico   binary
*.pdf   binary
*.ttf   binary
*.woff  binary
*.woff2 binary
