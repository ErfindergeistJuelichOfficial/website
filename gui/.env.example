# Path to the album source directory on the host (mounted read-only as /source)
SOURCE_DIR=/path/to/albums

# Set to true and rebuild to install torch/transformers/facenet-pytorch
# Required for: florence-2 (VISION_MODEL) and owlvit/mtcnn (BLUR_MODEL)
INSTALL_AI=false

# FTP credentials for upload/download (FTP_USER and FTP_PASS are required)
FTP_HOST=erfindergeist.org
FTP_USER=
FTP_PASS=
FTP_REMOTE_DIR=/

# Image processing
THUMBNAIL_WIDTH=400
NORMALIZED_MAX=1920
QUALITY_THUMB=60
QUALITY_NORM=85

# HuggingFace token — optional, but enables higher rate limits and faster model downloads
HF_TOKEN=

# AI caption generation
# Options: disabled, florence-2
VISION_MODEL=florence-2
# Images per caption inference call — increase for better throughput on CUDA
CAPTION_BATCH_SIZE=4

# Face blur models (comma-separated, one or more)
# Options: haar, owlvit, mtcnn
BLUR_MODEL=haar, owlvit

# AI inference device: cpu|cuda
DEVICE=cuda
