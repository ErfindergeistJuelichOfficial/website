# Path to the album source directory on the host (mounted read-only as /source)
SOURCE_DIR=/path/to/albums

# FTP credentials for upload/download (FTP_USER and FTP_PASS are required)
FTP_HOST=erfindergeist.org
FTP_USER=
FTP_PASS=
FTP_REMOTE_DIR=/galerie

# Image processing
THUMBNAIL_WIDTH=400
NORMALIZED_MAX=1920
QUALITY_THUMB=80
QUALITY_NORM=85

# AI caption generation: disabled|florence-2
VISION_MODEL=disabled
CAPTION_BATCH_SIZE=1

# Face blur models (comma-separated): haar|owlvit|mtcnn
BLUR_MODEL=haar

# AI inference device: cpu|cuda
DEVICE=cpu
