{
    "name": "erfindergeist/website",
    "description": "Erfindergeist Share and Termine",
    "type": "project",
    "license": "proprietary",
    "require": {
        "php": ">=8.3"
    },
    "require-dev": {
        "squizlabs/php_codesniffer": "^3.10",
        "phpstan/phpstan": "^1.12",
        "vimeo/psalm": "^6.0",
        "phpmd/phpmd": "^2.15"
    },
    "scripts": {
        "phpcbf":   "phpcbf",
        "phpcs":    "phpcs",
        "phpstan":  "phpstan analyse --no-progress --memory-limit 512M",
        "psalm":    "psalm --taint-analysis --no-progress",
        "phpmd":    "phpmd . text .phpmd.xml --exclude vendor/,templates/",
        "analyse": ["@phpcs", "@phpstan", "@psalm", "@phpmd"]
    }
}
